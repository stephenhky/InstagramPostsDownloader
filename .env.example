# Media Downloader Configuration
# Copy this file to .env and customize as needed.

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Directory paths (relative to project root)
DOWNLOADS_BASE_DIR=downloads
SESSIONS_DIR=sessions

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1

# Google Sheets
# GOOGLE_SERVICE_ACCOUNT_JSON can be either:
#   - A path to a service account JSON key file, e.g. ./service_account.json
#   - Or the raw JSON content of the service account key
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Future: Telegram Bot
# TELEGRAM_BOT_TOKEN=
